# Apache .htaccess configuration for Maharaj-ji Speaks
# Suitable for InMotion Hosting, cPanel, or any Apache HTTP server

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. CORS headers for API calls
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-groq-key"
  </IfModule>

  # 2. If running Node.js backend on a local port (e.g. 3000), reverse-proxy /api/
  # Uncomment the lines below if proxying /api/ to a local Node.js process:
  # <IfModule mod_proxy.c>
  #   RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  # </IfModule>

  # 3. Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback all other URLs to index.html for Single-Page Application (SPA) routing
  RewriteRule ^ index.html [L]
</IfModule>

# Caching and compression for static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
